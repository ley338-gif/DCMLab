# Zentrale Konfiguration fuer `docker compose`. Kopieren nach .env und anpassen.
# Die Laravel-App liest ihre eigene Konfiguration aus apps/web/.env (siehe dort).

# --- Postgres ---
POSTGRES_DB=dcmlab
POSTGRES_USER=dcmlab
POSTGRES_PASSWORD=change-me-in-production
# Host-Port nach aussen. Auf diesem Rechner laeuft bereits ein Postgres auf 5432,
# deshalb hier ein anderer Port als Default.
POSTGRES_HOST_PORT=5433

# --- Redis ---
REDIS_HOST_PORT=6380

# --- Webapp ---
APP_HOST_PORT=8090

# --- Internes Secret zwischen Laravel, Engine und Orchestrator (Abschnitt 3.3) ---
# Niemals der Wert aus dieser Beispieldatei in Produktion.
DCMLAB_INTERNAL_KEY=change-me-in-production

# --- Sandbox (Spielwiese, ab P7) ---
SANDBOX_IDLE_TIMEOUT_MINUTES=60
