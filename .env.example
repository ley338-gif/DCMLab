# Zentrale Konfiguration fuer `docker compose`. Kopieren nach .env und anpassen.
# Die Laravel-App liest ihre eigene Konfiguration aus apps/web/.env (siehe dort).

# --- Postgres ---
POSTGRES_DB=dcmlab
POSTGRES_USER=dcmlab
POSTGRES_PASSWORD=change-me-in-production
# Host-Port nach aussen. Auf diesem Rechner laeuft bereits ein Postgres auf 5432,
# deshalb hier ein anderer Port als Default.
POSTGRES_HOST_PORT=5433

# --- Valkey (Redis-Ersatz, siehe docs/adr/0003) ---
REDIS_HOST_PORT=6380

# --- Webapp ---
APP_HOST_PORT=8090

# --- Internes Secret zwischen Laravel, Engine und Orchestrator (Abschnitt 3.3) ---
# Niemals der Wert aus dieser Beispieldatei in Produktion.
DCMLAB_INTERNAL_KEY=change-me-in-production

# --- Laravel APP_KEY (ADR 0087) ---
# Zentral hier statt pro Container lokal generiert (apps/web/docker/entrypoint.sh
# generiert nur noch einen Fallback-Wert, wenn diese Variable leer bleibt) --
# app- und scheduler-Container muessen denselben Schluessel benutzen, sonst
# koennen sie sich gegenseitig verschluesselte Werte (Sessions, signierte URLs)
# nicht lesen. Einmalig erzeugen, z. B.:
#   echo "base64:$(openssl rand -base64 32)"
# und das Ergebnis hier eintragen. Niemals leer lassen oder committen.
APP_KEY=

# --- Sandbox (Spielwiese, ab P7) ---
SANDBOX_IDLE_TIMEOUT_MINUTES=60
