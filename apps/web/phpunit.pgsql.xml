<?xml version="1.0" encoding="UTF-8"?>
<!--
    Optionale Postgres-Parität-Suite (siehe README.md "Tests sicher
    ausführen" und docs/adr/0069-test-datenbank-isolation.md). Die
    Default-Suite (phpunit.xml) läuft gegen SQLite :memory:, schnell und per
    Bauart unmöglich mit einer echten Datenbank zu verwechseln, aber blind
    für Postgres-spezifisches Verhalten, zum Beispiel `uuid`-Spalten, die
    SQLite nicht durchsetzt. Genau das hat den Vorfall mit den
    NodeController-Tests gegen die echte Dev-DB unsichtbar gemacht.

    Aufruf: vendor/bin/pest, Option "configuration", Wert phpunit.pgsql.xml
    Voraussetzung: Datenbank "dcmlab_test" existiert (siehe
    `make test-db-pgsql` bzw. README).

    force="true" aus demselben Grund wie in phpunit.xml: die eigene
    Konfiguration muss jede geerbte Umgebungsvariable überschreiben statt
    sich stillschweigend auf sie zu verlassen.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5433" force="true"/>
        <env name="DB_DATABASE" value="dcmlab_test" force="true"/>
        <env name="DB_USERNAME" value="dcmlab" force="true"/>
        <env name="DB_PASSWORD" value="change-me-in-production" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
