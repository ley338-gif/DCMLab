# Fuer `docker-compose.yml: services.app.env_file`. Bewusst getrennt von
# .env.example: env_file wird von Docker Compose auf dem HOST ausgewertet und
# als Prozessumgebung an den Container uebergeben, bevor der Container laeuft.
# Ein leerer "APP_KEY="-Wert wuerde hier die vom Entrypoint generierte
# Konfiguration im Container ueberschreiben (Symfony Dotenv ist "immutable"),
# deshalb fehlt APP_KEY (und DB_PASSWORD, das per docker-compose.yml aus dem
# zentralen .env kommt) in dieser Datei absichtlich komplett.
APP_NAME="DCM Lab"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=dcmlab

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dcm-lab.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
